generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  firebaseUid       String    @unique
  email             String    @unique
  name              String
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Onboarding
  adhdExperience    String?
  primaryGoals      String[]
  biggestChallenge  String?
  onboardingComplete Boolean  @default(false)

  // Settings
  theme             String    @default("auto")
  notificationsEnabled Boolean @default(true)
  hapticFeedback    Boolean   @default(true)
  soundEffects      Boolean   @default(true)

  // Relations
  tasks             Task[]
  timelineBlocks    TimelineBlock[]
  habits            Habit[]
  routines          Routine[]
  focusSessions     FocusSession[]
  nudgePreference   NudgePreference?
  moodEntries       MoodEntry[]
  captureItems      CaptureItem[]
  progress          UserProgress?
  badges            UserBadge[]
  xpEvents          XPEvent[]
  passiveTrackingEvents PassiveTrackingEvent[]
  attentionReports  AttentionReport[]
  trackingBlocklist TrackingBlocklist[]
  mindMapNodes      MindMapNode[]
  mindMapEdges      MindMapEdge[]
  lessonReflections LessonReflection[]
  lessonThreads     LessonThread[]
  lessonComments    LessonComment[]
  userCosmetics     UserCosmetic[]
  partyMembers      PartyMember[]
  streakArmor       StreakArmor?
  
  // Non-drug treatment relations
  cbtInterventions       CBTIntervention[]
  thoughtLogs            ThoughtLog[]
  cognitiveProfile       CognitiveProfile?
  focusSessionPlans      FocusSessionPlan[]
  cognitiveTraining      CognitiveTrainingSession[]
  mindfulnessSessions    MindfulnessSession[]
  educationProgress      EducationProgress?
  triggeredEducation     TriggeredEducation[]
  tdcsSessions           TDCSSession[]
  
  // Learning & Study relations
  studySets              StudySet[]
  quizzes                Quiz[]
  notes                  Note[]
  noteFolders            NoteFolder[]
  documents              Document[]
  dailyLists             DailyList[]
  things                 Thing[]
  aiToolUsage            AIToolUsage[]
  taskLists              TaskList[]
  smartLists             SmartList[]
  widgetPresets          WidgetPreset[]

  @@map("users")
}

model Task {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  title             String
  description       String?
  notes             String?

  parentTaskId      String?
  parentTask        Task?       @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks          Task[]      @relation("Subtasks")

  order             Int         @default(0)
  status            String      @default("inbox") // inbox, todo, in_progress, waiting, done, abandoned

  dueDate           DateTime?
  dueTime           String?
  scheduledDate     DateTime?
  scheduledTime     String?

  estimatedMinutes  Int?
  actualMinutes     Int?

  priority          String      @default("none") // urgent_important, important, urgent, low, none
  energyRequired    String      @default("medium") // low, medium, high

  tags              String[]
  projectId         String?
  listId            String?
  context           String?

  recurrence        Json?
  smallestFirstStep String?

  aiDecompositionUsed Boolean   @default(false)
  source            String      @default("manual") // manual, voice, ai, share

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  completedAt       DateTime?
  startDate         DateTime?
  startTime         String?
  snoozedUntil      DateTime?

  reminders         Reminder[]
  focusSessions     FocusSession[]
  timelineBlocks    TimelineBlock[]
  checklistItems    TaskChecklistItem[]
  mindMapNodes      MindMapNode[]
  list              TaskList?   @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([listId])
  @@map("tasks")
}

model Reminder {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  time      DateTime
  type      String   @default("notification") // notification, alarm
  sent      Boolean  @default(false)
  locationName String?
  locationLat  Float?
  locationLng  Float?
  snoozeUntil  DateTime?

  @@index([taskId])
  @@map("reminders")
}

model TaskChecklistItem {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  estimatedMinutes Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskList {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  icon      String?
  order     Int      @default(0)
  isPinned  Boolean  @default(false)
  isDefault Boolean  @default(false)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("task_lists")
}

model SmartList {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  icon      String?
  color     String?
  preset    Boolean  @default(false)
  pinned    Boolean  @default(false)
  filters   Json
  sort      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId, pinned])
  @@map("smart_lists")
}

model WidgetPreset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // quick_add, pinned_list, today_summary, habit_widget, focus_widget
  title     String?
  config    Json?
  order     Int      @default(0)
  isPinned  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@map("widget_presets")
}

model Habit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  icon            String?
  color           String?

  frequencyType   String   @default("daily") // daily, weekly, specific_days
  daysOfWeek      Int[]    // 0 = Sunday, 6 = Saturday
  targetCount     Int      @default(1)

  anchorHabitId   String?
  anchorDescription String?

  preferredTime   String?
  reminderEnabled Boolean  @default(false)
  reminderTime    String?

  allowPartialCredit Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?

  logs            HabitLog[]

  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  completed   Boolean  @default(false)
  partialCredit Float?
  note        String?

  createdAt   DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
  @@map("habit_logs")
}

model Routine {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  icon        String?
  type        String   @default("custom") // morning, evening, work, custom

  daysActive  Int[]    // 0 = Sunday, 6 = Saturday
  triggerTime String?

  strictOrder Boolean  @default(true)
  allowSkips  Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  steps       RoutineStep[]
  executions  RoutineExecution[]

  @@index([userId])
  @@map("routines")
}

model RoutineStep {
  id              String  @id @default(uuid())
  routineId       String
  routine         Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  name            String
  icon            String?
  estimatedMinutes Int    @default(5)
  order           Int

  isSkippable     Boolean @default(true)
  linkedHabitId   String?

  @@index([routineId])
  @@map("routine_steps")
}

model RoutineExecution {
  id          String    @id @default(uuid())
  routineId   String
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  stepsCompleted Int     @default(0)
  stepsSkipped   Int     @default(0)
  totalDuration  Int?    // in minutes

  stepResults   Json?    // Array of step results

  @@index([routineId])
  @@map("routine_executions")
}

model FocusSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId          String?
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timelineBlockId String?
  timelineBlock   TimelineBlock? @relation(fields: [timelineBlockId], references: [id], onDelete: SetNull)
  taskDescription String

  plannedDuration Int       // in minutes
  actualDuration  Int?      // in minutes
  breakDuration   Int?      // in minutes
  longBreakDuration Int?    // in minutes
  sessionType     String    @default("pomodoro") // pomodoro, deep_work, sprint
  autoContinue    Boolean   @default(false)
  status          String    @default("active") // active, completed, cancelled, interrupted, extended
  outcome         String?

  startTime       DateTime  @default(now())
  endTime         DateTime?

  interruptions   Json?     // Array of interruption objects
  backgroundSound String?
  ambientVolume   Int?      // 0-100

  qualityRating   Int?      // 1-5
  completedTask   Boolean   @default(false)
  xpEarned        Int       @default(0)

  @@index([userId])
  @@index([startTime])
  @@index([timelineBlockId])
  @@map("focus_sessions")
}

model TimelineBlock {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  title       String
  type        String   @default("task") // task, focus, break, buffer, routine, event
  startTime   DateTime
  endTime     DateTime
  day         DateTime @db.Date
  color       String?
  isBuffer    Boolean  @default(false)
  order       Int      @default(0)
  notes       String?

  focusSessions FocusSession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, day])
  @@index([userId, startTime])
  @@index([taskId])
  @@map("timeline_blocks")
}

model NudgePreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled              Boolean  @default(true)
  preTransitionMinutes Int      @default(5)
  driftDetectionMinutes Int     @default(2)
  soundsEnabled        Boolean  @default(true)
  hapticsEnabled       Boolean  @default(true)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("nudge_preferences")
}

model CaptureItem {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentType     String    // text, voice, photo, link
  textContent     String?
  voiceUrl        String?
  voiceTranscript String?
  voiceDuration   Int?      // in seconds
  photoUrl        String?
  linkUrl         String?
  linkMetadata    Json?

  status          String    @default("pending") // pending, processed, dismissed
  processedAt     DateTime?
  convertedToType String?   // task, habit, note, event
  convertedToId   String?

  aiSuggestion    Json?

  capturedAt      DateTime  @default(now())
  source          String    @default("app") // app, widget, share, notification
  metadata        CaptureMetadata?

  @@index([userId])
  @@index([status])
  @@map("capture_items")
}

model MoodEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  moodLevel   Int      // 1-5
  energyLevel Int      // 1-5
  descriptor  String?

  timestamp   DateTime @default(now())

  contextTaskId String?
  tasksCompletedToday Int?
  sleepLogged   Boolean?
  exerciseLogged Boolean?
  medicationTaken Boolean?

  @@index([userId])
  @@index([timestamp])
  @@map("mood_entries")
}

model UserProgress {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp         Int     @default(0)
  level           Int     @default(1)

  progressMetaphor String @default("minimal") // minimal, garden, pet, adventure
  petName         String?
  petType         String?
  petLevel        Int?
  petHappiness    Int?

  tasksCompleted  Int     @default(0)
  focusMinutes    Int     @default(0)
  habitsLogged    Int     @default(0)
  routinesCompleted Int   @default(0)

  currentStreak   Int     @default(0)
  longestStreak   Int     @default(0)
  lastActiveDate  DateTime?

  @@map("user_progress")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String
  category    String   // tasks, focus, habits, routines, streaks, special

  criteriaType  String
  criteriaValue Int
  criteriaMetric String

  rarity      String   @default("common") // common, uncommon, rare, epic, legendary

  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt  DateTime @default(now())
  isNew     Boolean  @default(true)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model XPEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Int
  source      String   // task_complete, subtask_complete, focus_session, habit_log, etc.
  sourceId    String?
  description String

  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("xp_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NON-DRUG ADHD TREATMENT MODELS
// CBT, Cognitive Remediation, Mindfulness, Psychoeducation, tDCS Tracking
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────────
// A. CBT (Cognitive Behavioral Therapy)
// ─────────────────────────────────────────────────────────────────────────────────

model CBTIntervention {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String
  
  triggeredAt     DateTime  @default(now())
  triggerType     String    // user_flagged, overdue_nudge, pattern_detected
  
  negativeThoughts Json     // Array of { id, text, presetKey }
  balancedThoughts Json     // Array of { id, text }
  twoMinuteAction String?
  
  outcome         String?   // completed_action, broke_down_task, lowered_bar, dropped_task, skipped
  outcomeNotes    String?
  
  completedAt     DateTime?
  
  @@index([userId])
  @@index([taskId])
  @@map("cbt_interventions")
}

model ThoughtLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId           String?
  
  patternTags      String[] // perfectionism, fear_of_criticism, boredom, etc.
  situation        String
  automaticThought String
  emotion          String
  emotionIntensity Int      // 1-10
  
  balancedThought  String?
  outcomeEmotion   String?
  outcomeIntensity Int?
  
  createdAt        DateTime @default(now())
  
  @@index([userId])
  @@index([patternTags])
  @@map("thought_logs")
}

// ─────────────────────────────────────────────────────────────────────────────────
// B. Cognitive Remediation
// ─────────────────────────────────────────────────────────────────────────────────

model CognitiveProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workingMemoryCapacity Int      @default(3) // Recommended steps 2-5
  lastAssessed          DateTime @default(now())
  assessmentHistory     Json?    // Array of { date, stepsAttempted, stepsRemembered, successRate }
  
  @@map("cognitive_profiles")
}

model FocusSessionPlan {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId            String
  
  steps                Json      // Array of { id, text, completed, forgotten }
  maxStepsRecommended  Int
  stepsRemembered      Int       @default(0)
  stepsForgotten       Int       @default(0)
  
  createdAt            DateTime  @default(now())
  completedAt          DateTime?
  
  @@index([userId])
  @@index([sessionId])
  @@map("focus_session_plans")
}

model CognitiveTrainingSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  skill        String   // working_memory, attention_switching, planning, etc.
  exerciseType String
  difficulty   Int      // 1-5
  duration     Int      // in seconds
  score        Int
  accuracy     Float
  
  startedAt    DateTime @default(now())
  completedAt  DateTime
  
  @@index([userId])
  @@index([skill])
  @@map("cognitive_training_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────────
// C. Mindfulness
// ─────────────────────────────────────────────────────────────────────────────────

model MindfulnessSession {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type                 String    // grounding_5_4_3_2_1, mindful_breathing, body_scan, etc.
  trigger              String    // focus_session_start, overwhelm_button, manual, etc.
  contextTaskId        String?
  contextFocusSessionId String?
  
  duration             Int       // in seconds
  completed            Boolean   @default(false)
  
  moodBefore           Int?      // 1-5
  moodAfter            Int?
  
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  
  @@index([userId])
  @@index([type])
  @@map("mindfulness_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────────
// D. Psychoeducation
// ─────────────────────────────────────────────────────────────────────────────────

model EducationProgress {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cardsViewed         String[]
  cardsBookmarked     String[]
  categoriesExplored  String[]
  lastCardAt          DateTime?
  streakDays          Int      @default(0)
  
  @@map("education_progress")
}

model TriggeredEducation {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cardId         String
  trigger        String    // reminder_fatigue, repeated_snoozing, task_abandonment, etc.
  triggerContext Json?     // { taskId, snoozeCount, interruptionCount, pattern }
  
  viewed         Boolean   @default(false)
  dismissed      Boolean   @default(false)
  helpfulRating  Int?      // 1-5
  
  shownAt        DateTime  @default(now())
  viewedAt       DateTime?
  
  @@index([userId])
  @@index([cardId])
  @@map("triggered_education")
}

// ─────────────────────────────────────────────────────────────────────────────────
// E. tDCS Tracking (for supervised studies only)
// ─────────────────────────────────────────────────────────────────────────────────

model TDCSSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sessionDate    DateTime @db.Date
  sessionTime    String
  duration       Int      // in minutes
  intensity      Float?   // in mA
  montage        String?  // electrode placement
  studyProtocol  String?
  
  // Pre-session ratings (1-5)
  preFocusRating  Int
  preMoodRating   Int
  preEnergyRating Int
  
  // Post-session ratings (1-5)
  postFocusRating  Int?
  postMoodRating   Int?
  postEnergyRating Int?
  
  sideEffects    Json?    // Array of { type, severity, duration, notes }
  notes          String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([userId])
  @@index([sessionDate])
  @@map("tdcs_sessions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// LEARNING & FLASHCARDS (Quizlet/NotebookLM-inspired)
// Spaced Repetition, Study Sets, Quizzes, AI-Generated Content
// ═══════════════════════════════════════════════════════════════════════════════

model StudySet {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  icon        String?
  color       String?
  
  isPublic    Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  
  // AI-generated metadata
  aiGenerated   Boolean  @default(false)
  sourceDocId   String?  // Reference to source document if AI-generated
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?
  
  cards         Flashcard[]
  quizzes       Quiz[]
  studySessions StudySession[]
  
  @@index([userId])
  @@map("study_sets")
}

model Flashcard {
  id          String    @id @default(uuid())
  studySetId  String
  studySet    StudySet  @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  
  front       String    // Question/term (supports markdown)
  back        String    // Answer/definition (supports markdown)
  hint        String?
  explanation String?   // Detailed explanation for learning
  
  imageUrlFront String?
  imageUrlBack  String?
  audioUrl      String?
  
  // Spaced Repetition (SM-2 Algorithm)
  easeFactor    Float     @default(2.5)  // E-Factor (1.3 - 2.5+)
  interval      Int       @default(0)    // Days until next review
  repetitions   Int       @default(0)    // Successful reviews in a row
  nextReview    DateTime?
  lastReview    DateTime?
  
  // Learning state
  learningState String    @default("new") // new, learning, review, relearning
  lapses        Int       @default(0)     // Times forgotten after learning
  
  tags          String[]
  order         Int       @default(0)
  
  // AI metadata
  aiGenerated   Boolean   @default(false)
  confidence    Float?    // AI confidence in the card quality
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  reviews       FlashcardReview[]
  
  @@index([studySetId])
  @@index([nextReview])
  @@index([learningState])
  @@map("flashcards")
}

model FlashcardReview {
  id          String    @id @default(uuid())
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId      String
  
  quality     Int       // 0-5 rating (SM-2: 0=complete blackout, 5=perfect)
  responseTime Int?     // milliseconds to answer
  
  // State before review
  prevEaseFactor Float
  prevInterval   Int
  
  // State after review
  newEaseFactor  Float
  newInterval    Int
  
  reviewedAt  DateTime  @default(now())
  
  @@index([flashcardId])
  @@index([userId])
  @@map("flashcard_reviews")
}

model StudySession {
  id          String    @id @default(uuid())
  studySetId  String
  studySet    StudySet  @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  userId      String
  
  mode        String    @default("review") // review, learn, cram, test
  
  cardsTotal      Int   @default(0)
  cardsReviewed   Int   @default(0)
  cardsCorrect    Int   @default(0)
  cardsIncorrect  Int   @default(0)
  cardsSkipped    Int   @default(0)
  
  // Detailed results
  cardResults     Json?  // Array of { cardId, quality, responseTime }
  
  duration        Int?   // seconds
  xpEarned        Int    @default(0)
  
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  
  @@index([studySetId])
  @@index([userId])
  @@map("study_sessions")
}

model Quiz {
  id          String    @id @default(uuid())
  studySetId  String?
  studySet    StudySet? @relation(fields: [studySetId], references: [id], onDelete: SetNull)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  
  type        String    @default("mixed") // multiple_choice, true_false, written, matching, mixed
  
  // Questions stored as JSON for flexibility
  // [{ id, type, question, options?, correctAnswer, explanation?, points }]
  questions   Json
  
  totalPoints Int       @default(0)
  timeLimit   Int?      // seconds (null = no limit)
  
  // AI generation metadata
  aiGenerated   Boolean  @default(false)
  sourceContent String?  // Original text used to generate quiz
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  attempts    QuizAttempt[]
  
  @@index([userId])
  @@index([studySetId])
  @@map("quizzes")
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  
  // Results
  score       Float     // Percentage (0-100)
  pointsEarned Int      @default(0)
  pointsTotal  Int      @default(0)
  
  // Detailed answers: [{ questionId, answer, correct, timeSpent }]
  answers     Json
  
  timeSpent   Int?      // seconds
  xpEarned    Int       @default(0)
  
  completedAt DateTime  @default(now())
  
  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTES & DOCUMENTS (NotebookLM-inspired)
// Smart Notes, Document Processing, AI Chat
// ═══════════════════════════════════════════════════════════════════════════════

model Note {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  content     String    // Markdown content
  
  folderId    String?
  folder      NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  tags        String[]
  isPinned    Boolean   @default(false)
  isFavorite  Boolean   @default(false)
  
  // AI-generated insights
  aiSummary     String?
  aiKeyPoints   String[]  // Extracted key points
  aiTags        String[]  // Auto-suggested tags
  
  // For semantic search (store embeddings separately or use pgvector)
  embeddingId   String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  // Relations
  mindMapNodes  MindMapNode[]
  
  @@index([userId])
  @@index([folderId])
  @@map("notes")
}

model NoteFolder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  icon        String?
  color       String?
  parentId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  notes       Note[]
  
  @@index([userId])
  @@map("note_folders")
}

model Document {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  originalName  String
  mimeType      String
  fileUrl       String
  fileSize      Int       // bytes
  
  // Processing status
  status        String    @default("pending") // pending, processing, completed, failed
  processedAt   DateTime?
  
  // Extracted content
  extractedText String?
  pageCount     Int?
  
  // AI-generated content
  aiSummary     String?
  aiKeyPoints   String[]
  aiOutline     Json?     // Structured outline
  
  // For semantic search
  embeddingId   String?
  
  // Generated study materials
  generatedFlashcards String?  // StudySet ID
  generatedQuiz       String?  // Quiz ID
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  chatMessages  DocumentChat[]
  
  @@index([userId])
  @@index([status])
  @@map("documents")
}

model DocumentChat {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  
  role        String   // user, assistant
  content     String
  
  // For citations
  citations   Json?    // [{ pageNumber, excerpt, relevance }]
  
  createdAt   DateTime @default(now())
  
  @@index([documentId])
  @@map("document_chats")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DAILY LISTS (Twos-inspired)
// Quick daily note-taking organized by date
// ═══════════════════════════════════════════════════════════════════════════════

model DailyList {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date        DateTime @db.Date
  
  items       DailyListItem[]
  
  @@unique([userId, date])
  @@index([userId])
  @@map("daily_lists")
}

model DailyListItem {
  id          String    @id @default(uuid())
  dailyListId String
  dailyList   DailyList @relation(fields: [dailyListId], references: [id], onDelete: Cascade)
  
  content     String
  type        String    @default("note") // note, task, idea, reminder
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  
  // Optional task conversion
  convertedToTaskId String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([dailyListId])
  @@map("daily_list_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// THINGS DATABASE (Twos-inspired)
// Personal database for tracking anything
// ═══════════════════════════════════════════════════════════════════════════════

model Thing {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  category    String   // movies, books, restaurants, recipes, ideas, places, people, etc.
  title       String
  subtitle    String?
  description String?
  imageUrl    String?
  
  rating      Int?     // 1-5
  status      String?  // want_to, in_progress, completed, etc.
  
  // Flexible metadata as JSON
  metadata    Json?    // { author, year, location, url, etc. }
  
  tags        String[]
  isFavorite  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([category])
  @@map("things")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AI TOOLS HISTORY
// Track usage of AI tools for analytics and improvement
// ═══════════════════════════════════════════════════════════════════════════════

model AIToolUsage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tool        String   // spoon_estimator, tone_rewriter, note_compiler, quiz_generator, etc.
  input       Json     // Tool-specific input
  output      Json     // Tool-specific output
  
  // User feedback
  wasHelpful  Boolean?
  feedback    String?
  
  // Performance
  processingTime Int?  // milliseconds
  tokensUsed     Int?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([tool])
  @@map("ai_tool_usage")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PASSIVE TRACKING & ATTENTION REPORTS (RescueTime-inspired)
// ═══════════════════════════════════════════════════════════════════════════════

model PassiveTrackingEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  source      String   // desktop, mobile, extension
  appName     String?
  appId       String?
  website     String?
  category    String?  // work, social, entertainment, comms
  durationSec Int      @default(0)
  isActiveWindow Boolean @default(true)
  blocked     Boolean  @default(false)
  collectedAt DateTime @default(now())
  metadata    Json?

  @@index([userId, collectedAt])
  @@map("passive_tracking_events")
}

model AttentionReport {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime @db.Date
  focusScore    Int      // 0-100
  topDistractors Json    // [{name, durationSec}]
  attentionLeaks Json?   // [{start,end,app,website}]
  suggestedBlocks Json?  // suggested timeline block adjustments

  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@map("attention_reports")
}

model TrackingBlocklist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String
  type      String   @default("website") // website, app
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("tracking_blocklist")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CAPTURE METADATA (Voicy-inspired)
// ═══════════════════════════════════════════════════════════════════════════════

model CaptureMetadata {
  id          String   @id @default(uuid())
  captureId   String   @unique
  capture     CaptureItem @relation(fields: [captureId], references: [id], onDelete: Cascade)

  engine      String?  // on_device, whisper, platform
  language    String?  // ISO code
  quality     String?  // high, medium, low
  diarization Json?    // speaker segments
  cleanupMode String?  // verbatim, concise, action-items
  discountApplied Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("capture_metadata")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MIND MAP (SimpleMind-inspired)
// ═══════════════════════════════════════════════════════════════════════════════

model MindMapNode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  content   String?
  color     String?
  icon      String?
  position  Json     // { x, y, scale }

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  noteId    String?
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingEdges MindMapEdge[] @relation("OutgoingEdges")
  incomingEdges MindMapEdge[] @relation("IncomingEdges")

  @@index([userId])
  @@map("mind_map_nodes")
}

model MindMapEdge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceId    String
  targetId    String
  source      MindMapNode @relation("OutgoingEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target      MindMapNode @relation("IncomingEdges", fields: [targetId], references: [id], onDelete: Cascade)

  label       String?
  style       Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([sourceId])
  @@index([targetId])
  @@map("mind_map_edges")
}

// ═══════════════════════════════════════════════════════════════════════════════
// LESSONS & COMMUNITY (Inflow-inspired)
// ═══════════════════════════════════════════════════════════════════════════════

model Lesson {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary     String
  content     String   // Markdown/HTML
  durationMin Int      @default(10)
  tags        String[]
  published   Boolean  @default(true)

  reflections LessonReflection[]
  threads     LessonThread[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("lessons")
}

model LessonReflection {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  response    String
  moodLevel   Int?     // 1-5
  submittedAt DateTime @default(now())

  @@index([userId])
  @@index([lessonId])
  @@map("lesson_reflections")
}

model LessonThread {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  createdAt   DateTime @default(now())

  comments    LessonComment[]

  @@index([lessonId])
  @@index([userId])
  @@map("lesson_threads")
}

model LessonComment {
  id          String   @id @default(uuid())
  threadId    String
  thread      LessonThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content     String
  moodSignal  Int?     // 1-5, optional quick mood check
  createdAt   DateTime @default(now())

  @@index([threadId])
  @@index([userId])
  @@map("lesson_comments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// GAMIFICATION (Habitica-inspired)
// ═══════════════════════════════════════════════════════════════════════════════

model CosmeticItem {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  rarity      String   @default("common") // common, rare, epic, legendary
  icon        String?
  costXp      Int      @default(0)
  category    String   @default("cosmetic") // cosmetic, armor, badge

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owners      UserCosmetic[]

  @@map("cosmetic_items")
}

model UserCosmetic {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId  String
  cosmetic    CosmeticItem @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  equipped    Boolean  @default(false)
  earnedFrom  String?
  acquiredAt  DateTime @default(now())

  @@unique([userId, cosmeticId])
  @@map("user_cosmetics")
}

model Party {
  id          String   @id @default(uuid())
  name        String
  description String?
  inviteCode  String   @unique

  members     PartyMember[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("parties")
}

model PartyMember {
  id          String   @id @default(uuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member") // member, admin

  joinedAt    DateTime @default(now())

  @@unique([partyId, userId])
  @@map("party_members")
}

model StreakArmor {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int      @default(1)
  durability  Int      @default(100)
  lastUpdated DateTime @default(now())

  @@map("streak_armor")
}
